# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://formcollector:your-password@localhost:5432/formcollector
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=UTC
# Use something hard to guess in production, e.g. manage-k7x2q9/ (keep the trailing slash)
ADMIN_URL=admin/
RATE_LIMIT_POSTS=120
RATE_LIMIT_WINDOW=60
HSTS_SECONDS=31536000

# Optional: auto-create an admin during deploy. Remove the password after the first deploy.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-password
