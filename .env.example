# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
DATABASE_URL=postgres://formcollector:your-password@localhost:5432/formcollector
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Number of reverse proxies in front of Django that you trust (0 locally, 1 on Render to start).
TRUSTED_PROXY_COUNT=0

# Optional
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=UTC
ADMIN_URL=admin/
RATE_LIMIT_POSTS=10
RATE_LIMIT_WINDOW=60
HSTS_SECONDS=31536000

# Optional: auto-create an admin during deploy. Remove the password after the first deploy.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=use-a-strong-password
